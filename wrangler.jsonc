{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyushoku-nenrei",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kyushoku-nenrei.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kyushoku-nenrei",
      "database_id": "86b97edd-f802-4209-b701-dcf8d0cb29e4",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
